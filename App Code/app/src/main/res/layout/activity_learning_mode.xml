<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <!--  ============================================  -->
    <!--   Main content (camera + joystick + timer)     -->
    <!--  ============================================  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <!--  TOP HALF: Camera  -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000">
            <ImageView android:id="@+id/camera_view" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:background="#0A0A0A"/>
            <!--  Back button  -->
            <TextView android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" android:textSize="28sp" android:textColor="#FFFFFF" android:background="@drawable/back_button_background" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_gravity="top|start" android:layout_marginTop="40dp" android:layout_marginStart="16dp" android:clickable="true" android:focusable="true"/>
            <!--  Stream status  -->
            <TextView android:id="@+id/tv_stream_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connecting..." android:textSize="12sp" android:textColor="#8E8E93" android:background="@drawable/back_button_background" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_gravity="bottom|start" android:layout_margin="16dp"/>
            <!--  Mode label  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEARNING" android:textSize="12sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:background="@drawable/back_button_background" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_gravity="top|end" android:layout_marginTop="40dp" android:layout_marginEnd="16dp"/>
            <!--  Timer  -->
            <TextView android:id="@+id/tv_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:20" android:textSize="20sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:background="@drawable/back_button_background" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="40dp" android:visibility="gone"/>
            <!--  Replay button  -->
            <TextView android:id="@+id/btn_replay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Replay" android:textSize="16sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:background="@drawable/button_primary" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="20dp" android:clickable="true" android:focusable="true" android:visibility="gone"/>
        </FrameLayout>
        <!--  BOTTOM HALF: Joystick (hidden until recording starts)  -->
        <FrameLayout android:id="@+id/joystick_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" android:visibility="gone">
            <com.robotcontroller.JoystickView android:id="@+id/joystick_view" android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center"/>
            <TextView android:id="@+id/tv_joystick_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X: 0% Y: 0%" android:textSize="11sp" android:textColor="#48484A" android:fontFamily="sans-serif" android:textAlignment="center" android:layout_gravity="bottom|center" android:layout_marginBottom="12dp"/>
        </FrameLayout>
    </LinearLayout>
    <!--  ============================================  -->
    <!--   Ready overlay (shown initially)              -->
    <!--  ============================================  -->
    <FrameLayout android:id="@+id/ready_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0000000" android:clickable="true" android:focusable="true">
        <!--  Back button on overlay  -->
        <TextView android:id="@+id/btn_back_ready" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ Back" android:textSize="17sp" android:textColor="#3E8EDE" android:fontFamily="sans-serif" android:padding="4dp" android:layout_gravity="top|start" android:layout_marginTop="48dp" android:layout_marginStart="24dp" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_gravity="center" android:padding="32dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧠" android:textSize="48sp" android:layout_marginBottom="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learning Mode" android:textSize="28sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Record a 20-second driving path.\nThe robot will learn and replay it." android:textSize="14sp" android:textColor="#8E8E93" android:textAlignment="center" android:lineSpacingExtra="4dp" android:layout_marginBottom="36dp"/>
            <TextView android:id="@+id/btn_start_joystick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Joystick Replay" android:textSize="17sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:background="@drawable/button_primary" android:paddingStart="36dp" android:paddingEnd="36dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_start_sensor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensor Replay" android:textSize="17sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:background="@drawable/button_primary" android:paddingStart="36dp" android:paddingEnd="36dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>